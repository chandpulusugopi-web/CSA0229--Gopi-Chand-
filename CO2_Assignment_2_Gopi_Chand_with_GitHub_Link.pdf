BT 1 0 0 1 0 154.8 Tm /F3 7.2 Tf 9 TL (#include <stdio.h>) Tj T* (int main\(void\) {) Tj T* (    double price, gross, discount, taxable, gst, total;) Tj T* (    int qty, senior;) Tj T* (    printf\("Enter price and quantity: "\);) Tj T* (    scanf\("%lf %d", &price, &qty\);) Tj T* (    printf\("Senior citizen? \(1=yes, 0=no\): "\);) Tj T* (    scanf\("%d", &senior\);) Tj T* (    gross = price * qty;) Tj T* (    discount = senior ? gross * 0.15 : 0.0;) Tj T* (    taxable = gross - discount;) Tj T* (    gst = taxable * 0.05;) Tj T* (    total = taxable + gst;) Tj T* (    if \(total > 1000.0\) total -= 50.0;) Tj T* (    printf\("Gross = %.2f\\\\nDiscount = %.2f\\\\nGST = %.2f\\\\nNet = %.2f\\\\n",) Tj T* (           gross, discount, gst, total\);) Tj T* (    return 0;) Tj T* (}) Tj T* ET
